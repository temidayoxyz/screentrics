{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screentrics",
  "version": "0.1.0",
  "identifier": "app.screentrics.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screentrics",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#f5f5f7"
      },
      {
        "label": "overlay",
        "title": "Screentrics capture",
        "url": "index.html?view=overlay",
        "width": 800,
        "height": 600,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
